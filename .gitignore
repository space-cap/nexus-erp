# =============================================================================
# Nexus ERP — Delphi / RAD Studio Project .gitignore
# =============================================================================

# ──────────────────────────────────────────────
# Delphi 컴파일 결과물
# ──────────────────────────────────────────────
*.dcu        # Delphi Compiled Unit
*.dpu        # Delphi Package Unit
*.dcuil      # IL 컴파일 결과물
*.exe        # 실행 파일
*.dll        # Dynamic Link Library
*.bpl        # Borland Package Library
*.dcp        # Delphi Compiled Package
*.map        # 링커 맵 파일
*.obj        # 오브젝트 파일
*.o

# ──────────────────────────────────────────────
# Delphi IDE 자동 생성 파일
# ──────────────────────────────────────────────
*.identcache        # 식별자 캐시
*.dproj.local       # 로컬 프로젝트 설정 (개인 IDE 경로 포함)
*.dsk               # 데스크탑 레이아웃
*.local             # 로컬 설정
*.stat              # 통계 파일
*.tvsconfig         # TestInsight 설정
*.cbTemp            # C++ Builder 임시 파일

# ──────────────────────────────────────────────
# RAD Studio 히스토리 / 복구 폴더
# ──────────────────────────────────────────────
__history/
__recovery/

# ──────────────────────────────────────────────
# 빌드 출력 폴더
# ──────────────────────────────────────────────
Win32/
Win64/
Android/
Android64/
iOSSimulator/
iOS/
OSX/
Linux64/
*.rsm        # RAD Studio 모듈
*.rbr        # Rad Studio Backup Resource

# ──────────────────────────────────────────────
# 리소스 컴파일 결과물 (소스 .rc 파일은 유지)
# ──────────────────────────────────────────────
*.res

# ──────────────────────────────────────────────
# 환경 설정 / 시크릿
# ──────────────────────────────────────────────
.env
.env.*
*.ini.local
secrets.*
config.local.*

# ──────────────────────────────────────────────
# 데이터베이스 파일 (개발 로컬 DB)
# ──────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.mdb
*.accdb

# ──────────────────────────────────────────────
# 로그 파일
# ──────────────────────────────────────────────
*.log
logs/
*.log.*

# ──────────────────────────────────────────────
# IDE — 기타 (VS Code, JetBrains 등)
# ──────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user
*.sln.docstates
Thumbs.db
desktop.ini

# ──────────────────────────────────────────────
# OS 생성 파일
# ──────────────────────────────────────────────
.DS_Store
ehthumbs.db
